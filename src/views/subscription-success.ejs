<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>Subscription Activated</title>
<script src="https://cdn.tailwindcss.com"></script>
</head>
 
<body class="bg-gray-100 flex items-center justify-center min-h-screen px-4">
 
  <div class="max-w-xl w-full bg-white shadow-2xl rounded-2xl p-8">
 
    <!-- Success Icon -->
<div class="flex justify-center">
<div class="bg-green-100 p-4 rounded-full">
<svg class="w-10 h-10 text-green-600" fill="none" stroke="currentColor" stroke-width="3"
          viewBox="0 0 24 24">
<path stroke-linecap="round" stroke-linejoin="round"
            d="M5 13l4 4L19 7" />
</svg>
</div>
</div>
 
    <h1 class="text-3xl font-bold text-center text-gray-800 mt-6">
      Subscription Activated 🎉
</h1>
 
    <p class="text-center text-gray-500 mt-2">
      Your subscription is now active.
</p>
 
    <!-- Subscription Details -->
<div class="mt-8 border-t pt-6 space-y-4 text-sm">
 
      <div class="flex justify-between">
<span class="text-gray-500">Subscription ID</span>
<span class="font-medium"><%= subscription.stripeSubscriptionId %></span>
</div>
 
      <div class="flex justify-between">
<span class="text-gray-500">Package</span>
<span class="font-medium"><%= subscription.package.title %></span>
</div>
 
      <div class="flex justify-between">
<span class="text-gray-500">Price</span>
<span class="font-semibold text-green-600">$<%= subscription.price %></span>
</div>
 
      <div class="flex justify-between">
<span class="text-gray-500">Start Date</span>
<span><%= subscription.currentPeriodStart.toDateString() %></span>
</div>
 
      <div class="flex justify-between">
<span class="text-gray-500">End Date</span>
<span><%= subscription.currentPeriodEnd.toDateString() %></span>
</div>
 
      <div class="flex justify-between">
<span class="text-gray-500">Status</span>
<span class="text-green-600 font-medium capitalize">
<%= subscription.status %>
</span>
</div>
 
    </div>
 
    <div class="mt-8">
<a href="/dashboard"
         class="block w-full text-center bg-green-600 hover:bg-green-700 text-white py-3 rounded-xl font-medium transition">
        Go to Dashboard
</a>
</div>
 
  </div>
 
</body>
</html>